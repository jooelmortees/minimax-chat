# --- App ---
NEXT_PUBLIC_APP_NAME=MiniMax Chat

# --- Supabase ---
# 1) Crea un proyecto en https://supabase.com/dashboard
# 2) Settings → API → copia "Project URL" y "anon public key"
NEXT_PUBLIC_SUPABASE_URL=https://<tu-proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- MiniMax ---
# Obtén tu API key en https://platform.minimaxi.com/user-center/basic-information/interface-key
MINIMAX_API_KEY=eyJ...
# Modelo a usar por defecto. Opciones: MiniMax-M3, MiniMax-M2.7, M2-her
MINIMAX_MODEL=MiniMax-M3
# URL base de la API (OpenAI-compatible)
MINIMAX_BASE_URL=https://api.minimax.io/v1

# --- MCP servers ---
# Ruta al fichero de configuración de servidores MCP (estilo Claude Desktop)
MCP_SERVERS_CONFIG=./mcp_servers.json

# --- Tavily (web search + extract + crawl) ---
# Obtén tu API key gratuita en https://app.tavily.com/home (1000 req/mes gratis)
TAVILY_API_KEY=tvly-...

# --- context7 (docs de librerías actualizadas) ---
# API key gratuita (recomendada) en https://context7.com/dashboard
# Si vacío, se conecta igual pero con rate limit más bajo.
CONTEXT7_API_KEY=

# --- Groq Whisper (transcripción de audio grabado) ---
# Crea tu API key gratuita en https://console.groq.com/keys
GROQ_API_KEY=gsk-...
# GROQ_STT_MODEL=whisper-large-v3

# --- AGENTS.md ---
# Ruta al AGENTS.md global (puede ser absoluto). Si está vacío, no se carga.
GLOBAL_AGENTS_PATH=
# Directorio de trabajo del proyecto (para leer AGENTS.md locales y .md del proyecto)
PROJECT_ROOT=.
